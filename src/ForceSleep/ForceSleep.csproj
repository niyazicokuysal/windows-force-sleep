    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ForceSleep</AssemblyName>
    <RootNamespace>ForceSleep</RootNamespace>
    <Product>Force Sleep</Product>
    <Description>Force Sleep</Description>
    <Authors>Niyazi Berkay Çokuysal</Authors>
    <Company>Niyazi Berkay Çokuysal</Company>
    <Copyright>© 2026 Niyazi Berkay Çokuysal</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\ForceSleep.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForceSleep.Tests" />
  </ItemGroup>

</Project>
