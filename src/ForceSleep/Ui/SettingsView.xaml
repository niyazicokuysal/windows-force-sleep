<UserControl x:Class="ForceSleep.Ui.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fs="clr-namespace:ForceSleep">
    <UserControl.Resources>
        <!-- One setting: title and description on the left, its control on the right. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static fs:L.NavSettings}" Style="{StaticResource TitleText}" Margin="0,0,0,4" />

        <!-- Automatic -->
        <TextBlock Text="{x:Static fs:L.SettingsAutomatic}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.WatchdogTitle}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.WatchdogDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Watchdog}" Click="OnChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Text="{x:Static fs:L.IdleSleepTitle}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Static fs:L.IdleSleepDesc}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <CheckBox x:Name="IdleSleep" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IdleSleep}" Click="OnChanged" />
                </Grid>
                <ComboBox x:Name="IdleMinutes" HorizontalAlignment="Left" MinWidth="140" Margin="0,10,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=IdleSleep}" SelectionChanged="OnIdleMinutesChanged" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.WaitForMediaTitle}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.WaitForMediaDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WaitForMedia}" Click="OnChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.NotifyWakeTitle}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.NotifyWakeDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyUnexpectedWake}" Click="OnChanged" />
            </Grid>
        </Border>

        <!-- When sleeping -->
        <TextBlock Text="{x:Static fs:L.SettingsWhenSleeping}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.CountdownSettingTitle}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.CountdownSettingDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Countdown}" Click="OnChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.PauseMediaTitle}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.PauseMediaDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PauseMediaBeforeSleep}" Click="OnChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.HibernateFallback}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.HibernateFallbackDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox x:Name="HibernateFallback" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HibernateFallback}" Click="OnChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Text="{x:Static fs:L.ShortcutTitle}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Static fs:L.ShortcutDesc}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="HotkeyBox" MinWidth="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 HorizontalContentAlignment="Center" Cursor="Hand"
                                 PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
                        <Button Content="{x:Static fs:L.Remove}" Margin="8,0,0,0" Click="OnRemoveHotkey" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="HotkeyError" Text="{x:Static fs:L.HotkeyInUse}" Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Appearance -->
        <TextBlock Text="{x:Static fs:L.SettingsAppearance}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static fs:L.ThemeTitle}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" SelectionChanged="OnThemeChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static fs:L.LanguageTitle}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="180" SelectionChanged="OnLanguageChanged" />
            </Grid>
        </Border>

        <!-- Startup -->
        <TextBlock Text="{x:Static fs:L.SettingsStartup}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Text="{x:Static fs:L.StartWithWindows}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Static fs:L.StartWithWindowsDesc}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <CheckBox x:Name="AutoStartBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="OnAutoStart" />
            </Grid>
        </Border>

        <!-- About -->
        <TextBlock Text="{x:Static fs:L.SettingsAbout}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/ForceSleep;component/Ui/ForceSleep.ico" Width="40" Height="40" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Force Sleep" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="{x:Static fs:L.SourceCode}" Margin="0,0,20,4" Click="OnSource" />
                        <Button Style="{StaticResource LinkButton}" Content="{x:Static fs:L.LogFile}" Margin="0,0,20,4" Click="OnLog" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Button Content="{x:Static fs:L.QuitApp}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,6" Click="OnQuit" />
    </StackPanel>
</UserControl>
