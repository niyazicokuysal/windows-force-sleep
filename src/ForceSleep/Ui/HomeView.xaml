<UserControl x:Class="ForceSleep.Ui.HomeView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fs="clr-namespace:ForceSleep">
    <!-- DataContext: AppController. Shared by the tray panel and the main window. -->
    <StackPanel>

        <!-- Status -->
        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="24" Background="#1B2646" VerticalAlignment="Top">
                    <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="22"
                               Foreground="{StaticResource MoonBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource SubtitleText}" FontSize="18" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main actions -->
        <Button Style="{StaticResource HeroButton}" Margin="0,8,0,8" Click="OnSleep"
                IsEnabled="{Binding NotBusy}">
            <StackPanel Orientation="Horizontal">
                <!-- Explicit: Fluent's default TextBlock color would win over the button's. -->
                <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" Margin="0,0,10,0"
                           Foreground="{StaticResource OnPrimaryBrush}" />
                <TextBlock Text="{x:Static fs:L.SleepNow}"
                           Foreground="{StaticResource OnPrimaryBrush}" />
            </StackPanel>
        </Button>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HibernateButton" Style="{StaticResource TileButton}" Click="OnHibernate" IsEnabled="{Binding NotBusy}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static fs:L.Hibernate}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource TileButton}" Click="OnScreenOff">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static fs:L.ScreenOff}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Sleep timer -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Static fs:L.SleepTimerTitle}" Style="{StaticResource SubtitleText}" FontSize="14" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ChipButton}" Tag="15" Click="OnTimer" />
                    <Button Style="{StaticResource ChipButton}" Tag="30" Click="OnTimer" />
                    <Button Style="{StaticResource ChipButton}" Tag="60" Click="OnTimer" />
                    <Button Style="{StaticResource ChipButton}" Tag="120" Click="OnTimer" />
                </WrapPanel>
                <Button Style="{StaticResource LinkButton}" Content="{x:Static fs:L.CancelTimer}" HorizontalAlignment="Left"
                        Click="OnCancelTimer" Visibility="{Binding SleepTimerActive, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <!-- Keep awake -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Static fs:L.KeepAwakeTitle}" Style="{StaticResource SubtitleText}" FontSize="14" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ChipButton}" Tag="30" Click="OnKeepAwake" />
                    <Button Style="{StaticResource ChipButton}" Tag="60" Click="OnKeepAwake" />
                    <Button Style="{StaticResource ChipButton}" Tag="120" Click="OnKeepAwake" />
                    <Button Style="{StaticResource ChipButton}" Tag="0" Click="OnKeepAwake" />
                </WrapPanel>
                <Button Style="{StaticResource LinkButton}" Content="{x:Static fs:L.StopKeepAwake}" HorizontalAlignment="Left"
                        Click="OnStopKeepAwake" Visibility="{Binding KeepAwakeActive, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource CaptionText}" Margin="2,8,0,0" />
    </StackPanel>
</UserControl>
